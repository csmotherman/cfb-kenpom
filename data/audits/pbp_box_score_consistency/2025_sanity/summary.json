  "reconstructability": {
    "completions": {
      "class": "EXACTLY_RECONSTRUCTABLE",
      "reason": "Completions are convention-independent: PASS_COMPLETION/PASS_TD records never move between rush/pass buckets."
    },
    "fourth_down_attempts": {
      "class": "APPROXIMATELY_RECONSTRUCTABLE",
