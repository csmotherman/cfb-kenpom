# Public site / Supabase values
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only Supabase billing write key. Prefer the modern sb_secret_ key.
SUPABASE_SECRET_KEY=sb_secret_...
# Legacy fallback if needed instead of SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=...

# Stripe server configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# LEILA Advanced — $1.99/month
STRIPE_PRO_PRICE_ID=price_...
# LEILA Advanced + Predictions — $4.99/month
STRIPE_PRO_PLUS_PRICE_ID=price_...

# Optional. Set to true after promotion codes are configured in Stripe.
STRIPE_ALLOW_PROMOTION_CODES=false

# Early Beta is implemented in web/lib/earlyBeta.ts and remains open through
# October 15, 2026 (Eastern Time). Paid checkout opens October 16.
