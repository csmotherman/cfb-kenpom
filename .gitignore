.env
.venv/
__pycache__/
*.pyc
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep

# Local research scratch data (multi-season CFBD pulls for one-off model
# research) -- not project data, never meant to be committed.
data/research/
node_modules/

.env.*
!.env.example
.vercel/
*.tsbuildinfo

# Premium datasets are hydrated only inside trusted build jobs.
# Never commit these files to the public repository.
site/advanced-data.js
web/public/data/advanced/
web/public/data/advanced-games/
web/public/data/predictions/
web/public/data/exploratory/
web/public/data/exploratory-games/
web/public/data/team-game-advanced/

# setuptools build metadata -- regenerated by "pip install -e" on every
# run from whatever .py files currently exist, so committing it just
# invites drift (and broke the daily refresh once the tree and the
# committed snapshot disagreed).
*.egg-info/

# Locally rendered social-post images (e.g. the weekly rankings PNG). Not
# uploaded anywhere by the generator yet -- inspected locally or via the
# workflow artifact, never committed.
build/social/
