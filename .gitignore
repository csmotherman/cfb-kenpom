.env
.venv/
__pycache__/
*.pyc
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep
node_modules/

.env.*
!.env.example
.vercel/
*.tsbuildinfo

# Premium datasets are hydrated only inside trusted build jobs.
# Never commit these files to the public repository.
site/advanced-data.js
web/public/data/advanced/
web/public/data/predictions/

# setuptools build metadata -- regenerated by "pip install -e" on every
# run from whatever .py files currently exist, so committing it just
# invites drift (and broke the daily refresh once the tree and the
# committed snapshot disagreed).
*.egg-info/
